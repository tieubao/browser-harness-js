{
  "id": "app-notion-com",
  "name": "Notion developer portal (internal connections)",
  "domains": [
    "app.notion.com"
  ],
  "notes": [
    "notes/overview.md"
  ],
  "nodeTools": {
    "list_connections": {
      "description": "List internal connections (rows of name lines) on the developer portal. Throws 'not signed in to app.notion.com' when signed out.",
      "path": "tools/connections.mjs",
      "callable": "listConnections",
      "args": {},
      "returns": {
        "type": "array",
        "description": "[{name, details[]}] per row, header excluded; ids come from open_connection"
      }
    },
    "open_connection": {
      "description": "Open a connection by exact name.",
      "path": "tools/connections.mjs",
      "callable": "openConnection",
      "args": {
        "name": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "{id,name}"
      }
    },
    "create_connection": {
      "description": "Create an API-token internal connection and land on its page. Does NOT reveal the token.",
      "path": "tools/connections.mjs",
      "callable": "createConnection",
      "args": {
        "name": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "{id,name}"
      }
    },
    "set_capabilities": {
      "description": "Set capability toggles and user-info level on the open connection (autosaves). Omitted keys unchanged.",
      "path": "tools/connections.mjs",
      "callable": "setCapabilities",
      "args": {
        "read": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        },
        "insert": {
          "type": "boolean"
        },
        "readComments": {
          "type": "boolean"
        },
        "insertComments": {
          "type": "boolean"
        },
        "sessions": {
          "type": "boolean"
        },
        "userInfo": {
          "type": "string",
          "description": "none|no_email|email"
        }
      },
      "returns": {
        "type": "object",
        "description": "resulting toggle state"
      }
    },
    "share_pages": {
      "description": "Grant the open connection access to pages by search query, then Save.",
      "path": "tools/connections.mjs",
      "callable": "sharePages",
      "args": {
        "queries": {
          "type": "array",
          "required": true
        },
        "exact": {
          "type": "boolean",
          "description": "menuitem text must end with the query"
        }
      },
      "returns": {
        "type": "object",
        "description": "{added,missing,summary}"
      }
    },
    "rename_connection": {
      "description": "Rename the open connection (explicit Save).",
      "path": "tools/connections.mjs",
      "callable": "renameConnection",
      "args": {
        "newName": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "{newName}"
      }
    },
    "reveal_token": {
      "description": "Reveal, read and re-hide the API token. Returns the raw secret: capture it into a variable, never print it.",
      "path": "tools/connections.mjs",
      "callable": "revealToken",
      "args": {},
      "returns": {
        "type": "string",
        "description": "ntn_ token"
      }
    },
    "list_spaces": {
      "description": "List every Notion workspace the signed-in user belongs to, via the internal API from an app.notion.com tab. Throws 'not signed in to app.notion.com' when signed out.",
      "path": "tools/workspace.mjs",
      "callable": "listSpaces",
      "args": {},
      "returns": {
        "type": "array",
        "description": "[{id,name,plan_type}]"
      }
    },
    "get_records": {
      "description": "Fetch records by id with syncRecordValuesSpace (internal API, any workspace).",
      "path": "tools/workspace.mjs",
      "callable": "getRecords",
      "args": {
        "table": {
          "type": "string",
          "required": true,
          "description": "block|collection|collection_view|space|..."
        },
        "ids": {
          "type": "array",
          "required": true
        },
        "spaceId": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "map id -> record value (double value unwrapped); null when missing"
      }
    },
    "query_collection": {
      "description": "Query a database view with queryCollection (internal API, any workspace).",
      "path": "tools/workspace.mjs",
      "callable": "queryCollection",
      "args": {
        "collectionId": {
          "type": "string",
          "required": true
        },
        "viewId": {
          "type": "string",
          "required": true
        },
        "spaceId": {
          "type": "string",
          "required": true
        },
        "limit": {
          "type": "integer",
          "description": "default 50"
        }
      },
      "returns": {
        "type": "object",
        "description": "{blockIds[], records{id: block value}}"
      }
    },
    "save_transaction": {
      "description": "Write blocks with saveTransactionsFanout (internal API, any workspace). Refuses a top-level page set (parent_table space) that lacks a non-empty permissions array, because that page becomes an uneditable role-none orphan.",
      "path": "tools/workspace.mjs",
      "callable": "saveTransaction",
      "args": {
        "spaceId": {
          "type": "string",
          "required": true
        },
        "operations": {
          "type": "array",
          "required": true,
          "description": "[{pointer:{table,id}, path, command: set|update|listAfter|listBefore|listRemove|setPermissionItem, args}]; spaceId is filled into each pointer"
        },
        "label": {
          "type": "string",
          "description": "debug.userAction label"
        }
      },
      "returns": {
        "type": "object",
        "description": "{ok,error}"
      }
    }
  }
}
